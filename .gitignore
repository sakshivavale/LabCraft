# ============================================================
# LabCraft – .gitignore
# Covers: Node.js, React, Python, general OS & editor files
# ============================================================

# --- Dependencies ---
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt

# --- Build Outputs ---
dist/
build/
*.egg-info/
*.egg
.next/
out/

# --- Environment & Secrets ---
.env
.env.local
.env.development
.env.production
*.env

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Testing ---
coverage/
.nyc_output/
htmlcov/

# --- Misc ---
*.tmp
*.bak
